{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "monstrum-mortis",
  "main": "src/server/worker.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "LaboratoryRoom" },
      { "name": "MATCHMAKING", "class_name": "MatchmakingPool" },
      { "name": "GUEST_LEASES", "class_name": "GuestLease" }
    ]
  },
  "exports": {
    "LaboratoryRoom": { "type": "durable-object", "storage": "sqlite" },
    "MatchmakingPool": { "type": "durable-object", "storage": "sqlite" },
    "GuestLease": { "type": "durable-object", "storage": "sqlite" }
  }
}
